---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ApplyFirst from '../components/ApplyFirst.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Insights from '../components/Insights.astro';
import FilterBar from '../components/FilterBar.astro';
import JobTable from '../components/JobTable.astro';
import TaxCalculator from '../components/TaxCalculator.astro';
import Methodology from '../components/Methodology.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <Header />

  <main>
    <!-- LOADING: calm skeleton in the shape of the results -->
    <div id="loading" class="max-w-6xl mx-auto px-4 md:px-6 pb-10" role="status" aria-live="polite">
      <p id="loadingText" class="text-sm text-ink-2 mb-5">Loading jobs&hellip;</p>
      <div id="loadingBlocks">
        <div class="skeleton h-[320px] mb-10"></div>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
          <div class="skeleton h-24 col-span-2 md:col-span-1"></div><div class="skeleton h-24"></div><div class="skeleton h-24"></div><div class="skeleton h-24 hidden md:block"></div><div class="skeleton h-24 hidden md:block"></div>
        </div>
      </div>
    </div>

    <div id="content" class="hidden">
      <ApplyFirst />

      <div class="max-w-6xl mx-auto px-4 md:px-6 pb-8">
        <div class="mb-6">
          <h2 id="viewTitle" style="scroll-margin-top: 1.5rem" class="font-serif text-[1.75rem] md:text-[2.25rem] leading-[1.12] text-ink">All categories</h2>
          <p id="viewSub" class="mt-1.5 text-sm text-ink-2 num"></p>
        </div>

        <KeyFigures />

        <!-- Phones: skip the charts and go straight to the list -->
        <a href="#jobs" id="jumpToJobs" class="btn md:hidden mb-8 inline-flex items-center gap-1.5 rounded-full border border-ink text-ink bg-surface px-4 py-2 text-sm font-semibold">
          <span>Jump to jobs (<span id="jumpCount" class="num">0</span>)</span><span aria-hidden="true">&darr;</span>
        </a>

        <Insights />
        <FilterBar />
        <JobTable />
        <TaxCalculator />
        <Methodology />
      </div>
    </div>
    <p id="appliedStatus" class="sr-only" role="status" aria-live="polite"></p>
    <div id="toast" class="toast" aria-hidden="true"><span id="toastMsg" class="toast-msg"></span><button type="button" id="toastAction" class="toast-action hidden">Undo</button></div>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ base }}>
// ==================================================================
// STATE
// ==================================================================
var VER = '', INDEX = null;
var JOBS = [];          // every unique job across all categories (index = _id)
var BY_KEY = {};        // job key -> job
var CAT_JOBS = {};      // category label -> unique jobs in that category
var ALL_JOBS = [];      // jobs of the selected category (or all)
var FILTERED = [], PAGE = 1, PER_PAGE = 25;
var SORT_KEY = 'date', SORT_ASC = false, charts = {};
var TAB = 'todo';       // job list tab: todo | progress | applied | removed
var TODO_N = 0;         // To apply count under the current filters
var WEEK_GOAL = 15;     // applications per week (funnel.py target)
var MOVE_DELAY = 1500;  // ms a job stays in place, tinted, before it moves to its new tab
var TODAY_HK = hkDate(new Date()), LATEST_RUN = TODAY_HK, UPDATED_TEXT = '';
var DB = base + (base.endsWith('/') ? '' : '/') + 'data/';

// Design tokens (same values as tailwind.config.mjs and global.css)
var C = {
  ink: '#1C1B19', ink2: '#57534E', ink3: '#716A64', rule: '#E7E2DA', paper: '#FAF8F5',
  accent: '#FF6B00', accentInk: '#C2410C', neutral: '#7A8896', neutralHover: '#5F6D7B'
};
var SRC_NAMES = { linkedin: 'LinkedIn', indeed: 'Indeed', google: 'Google Jobs', jobsdb: 'JobsDB', lever: 'Lever', greenhouse: 'Greenhouse' };
var LEVEL_RANK = { 'Junior': 1, 'Mid': 2, 'Senior': 3, 'Manager': 4, 'Director+': 5 };
var TEXT_KEYS = { title: 1, company: 1, work_mode: 1, source: 1, seniority: 1 };

// Apply-first ranking: data roles are the main focus, web / AI automation / SEO secondary
var CAT_BOOST = {
  'Data Analyst': 12, 'Business Intelligence': 12, 'Fraud & Risk Analyst': 10,
  'AI Agents & Automation': 8, 'Technical SEO': 7, 'Web Developer': 7, 'Product Analyst': 6,
  'Python & Automation': 5, 'Full Stack Developer': 3, 'Data Engineer': 2
};
var AGE_BONUS = { 0: 15, 1: 12, 2: 8, 3: 5 };
// Profile skills for the one-line "why" (strongest first; mirrors PROFILE_SKILLS in generate_data.py)
var PROFILE = [
  ['power bi', 'Power BI'], ['sql', 'SQL'], ['python', 'Python'], ['excel', 'Excel'],
  ['data analysis', 'data analysis'], ['fraud', 'fraud'], ['technical seo', 'technical SEO'], ['seo', 'SEO'],
  ['dashboard', 'dashboards'], ['reporting', 'reporting'], ['copilot studio', 'Copilot Studio'],
  ['power automate', 'Power Automate'], ['aml', 'AML'], ['kyc', 'KYC'], ['risk management', 'risk management'],
  ['google analytics', 'Google Analytics'], ['snowflake', 'Snowflake'], ['kpi', 'KPIs'], ['bi', 'BI'],
  ['llm', 'LLMs'], ['generative ai', 'generative AI'], ['ai agent', 'AI agents'], ['javascript', 'JavaScript'],
  ['php', 'PHP'], ['wordpress', 'WordPress'], ['mysql', 'MySQL'], ['html', 'HTML'], ['css', 'CSS'], ['r', 'R'],
  ['data governance', 'data governance'], ['data quality', 'data quality']
];
var REDUCED_MOTION = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var nf = function (n) { return Number(n || 0).toLocaleString('en-US'); };
function $(id) { return document.getElementById(id); }

// ==================================================================
// APPLIED MARKS (per browser; the page must work without storage)
// ==================================================================
var APPLIED_KEY = 'hkjobs.applied.v1', APPLIED = {};
function loadApplied() {
  try {
    var raw = window.localStorage.getItem(APPLIED_KEY);
    var o = raw ? JSON.parse(raw) : {};
    if (o && typeof o === 'object' && !Array.isArray(o)) APPLIED = o;
  } catch (e) { APPLIED = {}; }
}
function saveApplied() {
  try { window.localStorage.setItem(APPLIED_KEY, JSON.stringify(APPLIED)); } catch (e) {}
}
function isApplied(j) { return Object.prototype.hasOwnProperty.call(APPLIED, j._k); }

// Removed ("not for me"): hidden from Apply first, To apply and In progress; the
// Removed tab can restore it. Same per-browser storage rules as APPLIED.
var REMOVED_KEY = 'hkjobs.removed.v1', REMOVED = {};
function loadRemoved() {
  try {
    var raw = window.localStorage.getItem(REMOVED_KEY);
    var o = raw ? JSON.parse(raw) : {};
    if (o && typeof o === 'object' && !Array.isArray(o)) REMOVED = o;
  } catch (e) { REMOVED = {}; }
}
function saveRemoved() {
  try { window.localStorage.setItem(REMOVED_KEY, JSON.stringify(REMOVED)); } catch (e) {}
}
function isRemoved(j) { return Object.prototype.hasOwnProperty.call(REMOVED, j._k); }

// Pipeline per job: 1 Read JD -> 2 Customize -> 3 Applied. Steps 1-2 live here,
// step 3 is APPLIED above (kept separate so existing applied marks survive).
var STAGE_KEY = 'hkjobs.stage.v1', STAGE = {};
function loadStage() {
  try {
    var raw = window.localStorage.getItem(STAGE_KEY);
    var o = raw ? JSON.parse(raw) : {};
    if (o && typeof o === 'object' && !Array.isArray(o)) STAGE = o;
  } catch (e) { STAGE = {}; }
}
function saveStage() {
  try { window.localStorage.setItem(STAGE_KEY, JSON.stringify(STAGE)); } catch (e) {}
}
function stageOf(j) { return STAGE[j._k] || {}; }
function markStep(j, step) {
  var s = STAGE[j._k] || (STAGE[j._k] = {});
  if (!s[step]) { s[step] = TODAY_HK; saveStage(); }
}
function resetStage(j) { delete STAGE[j._k]; saveStage(); }

// Status drives the tabs and the colours: todo (untouched), progress (read or customized), applied
function statusOf(j) {
  if (isApplied(j)) return 'applied';
  if (isRemoved(j)) return 'removed';
  var s = stageOf(j);
  return (s.read || s.custom) ? 'progress' : 'todo';
}
function appliedOn(j) { var d = APPLIED[j._k]; return typeof d === 'string' ? d : ''; }
// Date of the last thing done on a job (applied, customized or read); '' if none
function activityOf(j) {
  if (isApplied(j)) return appliedOn(j);
  if (isRemoved(j)) return typeof REMOVED[j._k] === 'string' ? REMOVED[j._k] : '';
  var s = stageOf(j);
  return [s.custom || '', s.read || ''].sort().pop();
}
// Full class names spelled out: Tailwind purges classes it cannot find in the source.
var ROW_CLS = { none: 'st-row-none', read: 'st-row-read', custom: 'st-row-custom', applied: 'st-row-applied', removed: 'st-row-removed' };
function rowState(j) {
  if (isApplied(j)) return 'applied';
  if (isRemoved(j)) return 'removed';
  var s = stageOf(j);
  return s.custom ? 'custom' : s.read ? 'read' : 'none';
}
function rowCls(j) { return ROW_CLS[rowState(j)]; }

function addDays(day, n) { return new Date(Date.parse(day) + n * 86400e3).toISOString().slice(0, 10); }
function daysSince(day) { return day ? Math.round((Date.parse(TODAY_HK) - Date.parse(day)) / 86400e3) : null; }
function fmtDay(day) {
  if (!day) return '';
  return new Date(Date.parse(day)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}
function relDay(day) {
  var n = daysSince(day);
  if (n === null) return '';
  if (n <= 0) return 'today';
  if (n === 1) return 'yesterday';
  return n + ' days ago';
}

// The coloured status line under a job's title. Always rendered (empty for untouched jobs)
// so a click can swap it in place.
function statusHtml(j) {
  var st = rowState(j), inner = '', id = j._id;
  if (st === 'applied') {
    var on = appliedOn(j);
    inner = '<span class="st-chip st-chip-applied"><span aria-hidden="true">&#10003;</span> Applied' + (on ? ' ' + esc(fmtDay(on)) : '') + '</span>';
    if (on) {
      var fu = addDays(on, 7);
      inner += fu <= TODAY_HK
        ? '<span class="st-chip st-chip-due" title="Outreach rule: one follow-up at day 7, only if no reply">Follow-up due ' + esc(fmtDay(fu)) + '</span>'
        : '<span class="st-note">Follow up ' + esc(fmtDay(fu)) + ' if no reply</span>';
    }
  } else if (st === 'removed') {
    var rd = REMOVED[j._k];
    inner = '<span class="st-chip st-chip-removed">Removed' + (typeof rd === 'string' ? ' ' + esc(fmtDay(rd)) : '') + '</span>';
  } else if (st !== 'none') {
    var s = stageOf(j), since = st === 'custom' ? s.custom : s.read, age = daysSince(since);
    inner = st === 'custom'
      ? '<span class="st-chip st-chip-custom">Customizing</span>'
      : '<span class="st-chip st-chip-read">JD read</span>';
    inner += '<span class="st-note' + (age >= 2 ? ' font-semibold text-accent-deep' : '') + '">' +
      (st === 'custom' ? 'customized ' : 'read ') + esc(relDay(since)) + '</span>';
    inner += '<button type="button" class="st-reset" data-reset="' + id + '" aria-label="Move back to To apply: ' + esc(j.title) + '">Reset</button>';
  }
  return '<span class="st-line" data-status="' + id + '">' + inner + '</span>';
}

var toastTimer = null, toastUndo = null;
function toast(msg, ms, undo) {
  var t = $('toast'), btn = $('toastAction');
  $('toastMsg').textContent = msg;
  toastUndo = undo || null;
  btn.classList.toggle('hidden', !undo);
  t.setAttribute('aria-hidden', undo ? 'false' : 'true');
  t.classList.add('show');
  $('appliedStatus').textContent = msg;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { t.classList.remove('show'); toastUndo = null; }, ms || (undo ? 7000 : 3200));
}
function hideToast() { clearTimeout(toastTimer); $('toast').classList.remove('show'); toastUndo = null; }
function copyText(text) {
  try {
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallbackCopy(text); });
  } catch (e) {}
  return Promise.resolve(fallbackCopy(text));
}
function fallbackCopy(text) {
  try {
    var ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = document.execCommand('copy'); document.body.removeChild(ta); return ok;
  } catch (e) { return false; }
}
// Raw (unescaped) values: these go to the clipboard, never into HTML.
function q(s) { return String(s || '').replace(/"/g, "'").replace(/\s+/g, ' ').trim(); }
function tailorText(j) {
  return '/tailor-application ' + q(j.title) + ' | ' + q(j.company) + ' | ' + String(j.url || '');
}
function funnelText(j) {
  return 'python funnel.py add --company "' + q(j.company) + '" --role "' + q(j.title) + '"' +
    (j.url ? ' --url ' + String(j.url) : '');
}

function onStep(step, id) {
  var j = JOBS[id]; if (!j) return;
  if (step === 'read') {
    markStep(j, 'read');
    toast('Step 1 done: reading ' + (j.title || 'the ad') + '. It is now In progress. Next: Customize.');
    // After the click finishes: swapping the link out mid-click can cancel the navigation
    setTimeout(function () { refreshJob(id); }, 0);
  } else if (step === 'custom') {
    markStep(j, 'read'); markStep(j, 'custom');
    copyText(tailorText(j)).then(function (ok) {
      toast(ok ? 'Copied the tailoring request. Paste it into Claude Code.' : 'Could not copy. Tailor: ' + tailorText(j), ok ? 0 : 10000);
    });
    refreshJob(id);
  } else if (step === 'applied') {
    if (!isApplied(j)) {
      setApplied(j, TODAY_HK);
      copyText(funnelText(j)).then(function (ok) {
        toast(ok ? 'Moved to Applied. funnel.py line copied: paste it in a terminal to log it.' : 'Moved to Applied. Log it: ' + funnelText(j),
          ok ? 0 : 12000, function () { setApplied(j, null); toast('Undone. Back where it was.'); });
      });
    } else {
      var was = appliedOn(j);
      setApplied(j, null);
      toast('Unmarked as applied.', 0, function () { setApplied(j, was || TODAY_HK); toast('Undone. Marked applied again.'); });
    }
  }
}
function setRemoved(j, day) {
  if (day) REMOVED[j._k] = day; else delete REMOVED[j._k];
  saveRemoved();
  $('appliedStatus').textContent = (day ? 'Removed: ' : 'Restored: ') + (j.title || '');
  refreshJob(j._id);
  scheduleMove(j._id);
}
function onRemove(id) {
  var j = JOBS[id]; if (!j || isApplied(j)) return;
  if (!isRemoved(j)) {
    setRemoved(j, TODAY_HK);
    toast('Removed. It will not show up again.', 0, function () { setRemoved(j, null); toast('Undone. Back where it was.'); });
  } else {
    var was = REMOVED[j._k];
    setRemoved(j, null);
    toast('Restored.', 0, function () { setRemoved(j, was || TODAY_HK); toast('Undone. Removed again.'); });
  }
}
function setApplied(j, day) {
  if (day) APPLIED[j._k] = day; else delete APPLIED[j._k];
  if (day && isRemoved(j)) { delete REMOVED[j._k]; saveRemoved(); }
  saveApplied();
  $('appliedStatus').textContent = (day ? 'Marked as applied: ' : 'Unmarked: ') + (j.title || '');
  refreshJob(j._id);
  scheduleMove(j._id);
}
// Re-render one job in place (steps, status line, colour) so the list does not jump while
// working on it. Counts and the weekly goal update at once.
function refreshJob(id) {
  var j = JOBS[id]; if (!j) return;
  document.querySelectorAll('[data-pipe="' + id + '"]').forEach(function (el) {
    el.outerHTML = pipeHtml(j, el.getAttribute('data-compact') === '1');
  });
  document.querySelectorAll('[data-status="' + id + '"]').forEach(function (el) { el.outerHTML = statusHtml(j); });
  var cls = rowCls(j);
  document.querySelectorAll('[data-row="' + id + '"]').forEach(function (el) {
    Object.keys(ROW_CLS).forEach(function (k) { el.classList.remove(ROW_CLS[k]); });
    el.classList.add(cls);
  });
  renderCounts();
}
// The job stays visible (now tinted) for a moment, then the lists re-render and it moves
// to its new tab; Apply first refills to 8. One timer for any burst of clicks.
var moveTimer = null, moveIds = {};
function scheduleMove(id) {
  moveIds[id] = 1;
  clearTimeout(moveTimer);
  moveTimer = setTimeout(settleMoves, REDUCED_MOTION ? 600 : MOVE_DELAY);
}
function settleMoves() {
  moveTimer = null;
  var ids = Object.keys(moveIds); moveIds = {};
  // Was keyboard focus on one of the moving jobs? Then keep it somewhere sensible.
  var act = document.activeElement, focusId = null;
  ids.forEach(function (id) { if (act && act.closest && act.closest('[data-row="' + id + '"]')) focusId = id; });
  renderPicks();
  applyFilters(true);
  if (focusId !== null) {
    var again = document.querySelector('[data-step="applied"][data-id="' + focusId + '"]');
    if (again && again.offsetParent !== null) again.focus({ preventScroll: true });
    else { var tab = document.querySelector('.tab[data-tab="' + statusOf(JOBS[focusId]) + '"]'); if (tab) tab.focus({ preventScroll: true }); }
  }
}
// ==================================================================
// FIND A CONTACT (LinkedIn people search, opened in his own logged-in browser)
// ==================================================================
// Format tested in his logged-in LinkedIn on 2026-10-07:
//  - company=<name> filters on CURRENT employer (keywords alone also matched past jobs,
//    which is why OCBC searches returned Deloitte and Alibaba people).
//  - titleFreeText is silently dropped by LinkedIn, so role words go in keywords.
//  - Long quoted OR-groups of titles returned nothing for small firms; simple words work.
//  - geoUrn 103291313 = Hong Kong (outreach rule 4: HK-verified only).
var LI_PEOPLE = 'https://www.linkedin.com/search/results/people/?origin=FACETED_SEARCH&geoUrn=%5B%22103291313%22%5D';
function liPeople(company, keywords) {
  return LI_PEOPLE + '&company=' + encodeURIComponent(company) + (keywords ? '&keywords=' + encodeURIComponent(keywords) : '');
}
// Staffing agencies post a large share of HK ads; their consultant IS the gatekeeper.
var AGENCIES = /\b(hays|robert walters|michael page|page personnel|randstad|ikas|morgan mckinley|robert half|adecco|persol|teksystems|manpower|kelly services|links international|hudson|harvey nash|achieve|leadership solutions|newrecs|justonegalaxy|eteam|peoplebank|it solutions|recruit|search|consult(ing|ancy) limited|talent|staffing|headhunt)/i;
function cleanCompany(c) {
  // "Orient Overseas Container Line Ltd (OOCL)": people's profiles say "OOCL", so a
  // short brand in brackets beats the legal name.
  var brand = /\(([A-Za-z0-9&\s]{2,20})\)?\s*$/.exec(String(c || '').trim());
  if (brand && !/^(asia|hong kong|hk|asia pacific)$/i.test(brand[1].trim())) return brand[1].trim();
  return String(c || '')
    .replace(/\((asia|hong kong|hk|asia pacific)\)/ig, ' ')
    .replace(/\b(limited|ltd\.?|co\.?|company|hong kong|hk|holdings?|group|inc\.?|corporation)\b/ig, ' ')
    .replace(/[,.|]+/g, ' ').replace(/\s+/g, ' ').trim();
}
// Simple words for the team that owns the role (matched against headline/title)
function teamWords(title) {
  var t = String(title || '').toLowerCase();
  if (/seo|search engine|digital marketing/.test(t)) return 'seo OR "digital marketing" OR marketing';
  if (/fraud|risk|aml|kyc|compliance|financial crime/.test(t)) return 'fraud OR risk OR compliance';
  if (/\bai\b|llm|agent|automation|machine learning|genai|generative/.test(t)) return 'AI OR automation OR data OR "digital transformation"';
  if (/web|developer|frontend|full stack|engineer/.test(t)) return 'engineering OR developer OR technology';
  return 'data OR analytics OR "business intelligence"';
}
function contactLinks(j, compact) {
  var co = cleanCompany(j.company);
  if (!co || /^confidential$/i.test(co) || /not given/i.test(co)) return '';
  var agency = AGENCIES.test(j.company || '');
  var links = [['People at ' + (co.length > 18 ? 'company' : co), liPeople(co, ''), 'Everyone currently at ' + co + ' in Hong Kong. At small firms this is the founder or manager.']];
  if (agency) {
    links.push(['Agency consultant', liPeople(co, '(consultant OR recruiter OR recruitment) AND (' + teamWords(j.title) + ')'), 'Consultants at ' + co + ' covering this field, Hong Kong only']);
  } else {
    links.push(['Recruiter', liPeople(co, 'recruiter OR "talent acquisition" OR "human resources" OR HR'), 'Recruiters and HR currently at ' + co + ', Hong Kong only']);
    links.push(['Hiring manager', liPeople(co, teamWords(j.title)), 'People in the team that owns this role, currently at ' + co + ', Hong Kong only']);
  }
  var html = links.map(function (l) {
    return '<a class="contact-link" href="' + esc(l[1]) + '" target="_blank" rel="noopener noreferrer" title="' + esc(l[2]) + '">' + esc(l[0]) + '</a>';
  }).join('');
  if (compact) return '<div class="mt-1 flex flex-wrap gap-x-2 text-xs">' + html + '</div>';
  return '<p class="contact-row"><span class="text-ink-3">Find contact on LinkedIn:</span> ' + html + '</p>';
}

function pipeHtml(j, compact) {
  var s = stageOf(j), applied = isApplied(j), url = safeUrl(j.url), title = esc(j.title);
  var done = { read: !!s.read || applied, custom: !!s.custom || applied, applied: applied };
  var next = !done.read ? 'read' : !done.custom ? 'custom' : !done.applied ? 'applied' : '';
  function cls(step) { return 'pipe-step' + (done[step] ? ' is-done' : '') + (next === step ? ' is-next' : ''); }
  function lab(n, full, short) {
    return '<span class="pipe-n" aria-hidden="true">' + (done[['', 'read', 'custom', 'applied'][n]] ? '&#10003;' : n) + '</span>' +
      (compact ? short : full);
  }
  var read = url !== '#'
    ? '<a class="' + cls('read') + '" href="' + url + '" target="_blank" rel="noopener noreferrer" data-step="read" data-id="' + j._id + '" aria-label="Step 1, read the job description: ' + title + '">' + lab(1, 'Read JD', 'Read') + '</a>'
    : '<span class="' + cls('read') + ' is-disabled">' + lab(1, 'Read JD', 'Read') + '</span>';
  // Remove ("not for me") sits beside the steps; a removed job offers Restore instead.
  // Applied jobs get neither: unmark Applied first.
  var rm = applied ? ''
    : isRemoved(j)
      ? '<button type="button" class="rm-btn" data-remove="' + j._id + '" aria-label="Restore: ' + title + '">Restore</button>'
      : '<button type="button" class="rm-btn" data-remove="' + j._id + '" aria-label="Remove, not for me: ' + title + '" title="Not for me: hide this job from every list"><span aria-hidden="true">&times;</span> Remove</button>';
  return '<div class="pipe-wrap" data-pipe="' + j._id + '" data-compact="' + (compact ? 1 : 0) + '">'
    + '<div class="pipe" role="group" aria-label="Pipeline: ' + title + '">'
    + read
    + '<button type="button" class="' + cls('custom') + '" data-step="custom" data-id="' + j._id + '" aria-label="Step 2, customize the resume: copy the tailoring request for ' + title + '">' + lab(2, 'Customize', 'Tailor') + '</button>'
    + '<button type="button" class="' + cls('applied') + '" data-step="applied" data-id="' + j._id + '" aria-pressed="' + applied + '" aria-label="Step 3, ' + (applied ? 'applied, click to undo: ' : 'mark applied: ') + title + '">' + lab(3, 'Applied', 'Applied') + '</button>'
    + '</div>' + rm + '</div>';
}
// ==================================================================
// COUNTS, WEEKLY GOAL, CONTINUE LINE
// ==================================================================
// HK week starts Monday
function weekStart() {
  var dow = new Date(Date.parse(TODAY_HK)).getUTCDay();
  return addDays(TODAY_HK, -((dow + 6) % 7));
}
function renderCounts() {
  var prog = [], appN = 0, rmN = 0;
  JOBS.forEach(function (j) {
    var st = statusOf(j);
    if (st === 'progress') prog.push(j); else if (st === 'applied') appN++; else if (st === 'removed') rmN++;
  });
  setTabN('progress', prog.length);
  setTabN('applied', appN);
  setTabN('removed', rmN);
  setTabN('todo', TODO_N);

  // Weekly goal: every Applied mark dated this week, including jobs no longer in the data
  var from = weekStart(), week = 0;
  Object.keys(APPLIED).forEach(function (k) { var d = APPLIED[k]; if (typeof d === 'string' && d >= from && d <= TODAY_HK) week++; });
  $('weekGoalN').textContent = week;
  $('weekGoalFill').style.width = Math.min(100, week / WEEK_GOAL * 100) + '%';
  $('weekGoalBar').setAttribute('aria-valuenow', String(week));
  $('weekGoal').classList.toggle('goal-met', week >= WEEK_GOAL);

  // Coming back the next day: point at the unfinished ones first
  var line = $('continueLine');
  if (prog.length) {
    var oldest = prog.map(activityOf).filter(Boolean).sort()[0];
    line.innerHTML = '<strong>' + prog.length + ' in progress</strong>' +
      (oldest && daysSince(oldest) > 0 ? ', the oldest touched ' + esc(relDay(oldest)) : '') +
      '. <a href="#jobs" id="continueLink" class="font-semibold text-accent-deep underline underline-offset-2">Finish them first</a>';
  }
  line.classList.toggle('hidden', !prog.length);
}
function setTabN(tab, n) {
  var el = $('tabN-' + tab);
  el.textContent = nf(n);
  el.classList.toggle('has', n > 0);
}
function setTab(tab) {
  TAB = tab;
  document.querySelectorAll('.tab[data-tab]').forEach(function (b) {
    b.setAttribute('aria-pressed', String(b.getAttribute('data-tab') === tab));
  });
  // Filters only narrow To apply; the other tabs are a full status list
  // Inline style: the hidden class loses to md:flex on desktop
  $('filtersMain').style.display = tab === 'todo' ? '' : 'none';
  $('filtersMore').style.display = tab === 'todo' ? '' : 'none';
  $('backupRow').classList.toggle('hidden', tab === 'todo');
  applyFilters();
}

// ==================================================================
// BACK UP / RESTORE the marks (they live in this browser only)
// ==================================================================
function backupMarks() {
  var data = { app: 'hk-jobs', version: 1, exported: TODAY_HK, applied: APPLIED, stage: STAGE, removed: REMOVED };
  try {
    var blob = new Blob([JSON.stringify(data, null, 1)], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'hkjobs-marks-' + TODAY_HK + '.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    toast('Saved ' + Object.keys(APPLIED).length + ' applied and ' + Object.keys(STAGE).length + ' started jobs to a file.');
  } catch (e) { toast('Could not create the backup file.'); }
}
function restoreMarks(file) {
  var r = new FileReader();
  r.onload = function () {
    var d;
    try { d = JSON.parse(String(r.result)); } catch (e) { toast('That file is not a marks backup.'); return; }
    if (!d || d.app !== 'hk-jobs' || typeof d.applied !== 'object' || typeof d.stage !== 'object' || !d.applied || !d.stage) {
      toast('That file is not a marks backup.'); return;
    }
    // Merge, never overwrite: keep the earliest date for anything marked in both places
    var added = 0;
    Object.keys(d.applied).forEach(function (k) {
      var v = d.applied[k]; if (typeof v !== 'string' || !/^\d{4}-\d\d-\d\d$/.test(v)) return;
      if (!APPLIED[k]) added++;
      if (!APPLIED[k] || v < APPLIED[k]) APPLIED[k] = v;
    });
    Object.keys(d.stage).forEach(function (k) {
      var s = d.stage[k]; if (!s || typeof s !== 'object') return;
      var cur = STAGE[k] || (STAGE[k] = {});
      ['read', 'custom'].forEach(function (step) {
        var v = s[step]; if (typeof v !== 'string' || !/^\d{4}-\d\d-\d\d$/.test(v)) return;
        if (!cur[step] || v < cur[step]) cur[step] = v;
      });
      if (!cur.read && !cur.custom) delete STAGE[k];
    });
    // Backups made before Remove existed have no "removed" key
    if (d.removed && typeof d.removed === 'object') {
      Object.keys(d.removed).forEach(function (k) {
        var v = d.removed[k]; if (typeof v !== 'string' || !/^\d{4}-\d\d-\d\d$/.test(v) || APPLIED[k]) return;
        if (!REMOVED[k] || v < REMOVED[k]) REMOVED[k] = v;
      });
    }
    saveApplied(); saveStage(); saveRemoved();
    renderPicks(); applyFilters(true);
    toast('Restored. ' + added + ' applied jobs added from the backup.');
  };
  r.onerror = function () { toast('Could not read that file.'); };
  r.readAsText(file);
}

// ==================================================================
// HELPERS
// ==================================================================
// Hong Kong calendar date (UTC+8, no DST) as YYYY-MM-DD
function hkDate(d) { return new Date(d.getTime() + 8 * 3600e3).toISOString().slice(0, 10); }
function ageDays(j) {
  if (!j.date) return null;
  return Math.max(0, Math.round((Date.parse(TODAY_HK) - Date.parse(j.date)) / 86400e3));
}
function isNew(j) { return !!j.first_seen && j.first_seen >= LATEST_RUN; }
function jobKey(j) {
  var u = String(j.url || '').trim().toLowerCase().replace(/\/$/, '');
  return u || ('t:' + String(j.title || '').toLowerCase() + '|' + String(j.company || '').toLowerCase());
}
function hasRealSalary(j) { return j.salary_num > 0 && !j.salary_est; }
function median(arr) {
  if (!arr.length) return 0;
  var s = arr.slice().sort(function (a, b) { return a - b; }), m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : Math.round((s[m - 1] + s[m]) / 2);
}

// Scraped text is untrusted: escape it before it goes into any HTML string.
var HTML_ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '`': '&#96;' };
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"'`]/g, function (ch) { return HTML_ESCAPES[ch]; }); }
// For href attributes: only http(s), and nothing that can break out of the attribute.
function safeUrl(u) {
  u = String(u || '').trim();
  if (!/^https?:\/\//i.test(u)) return '#';
  return u.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// ==================================================================
// LOAD
// ==================================================================
async function init() {
  loadApplied(); loadStage(); loadRemoved();
  try {
    INDEX = await (await fetch(DB + 'index.json', { cache: 'no-cache' })).json();
  } catch (e) { showErr('Could not load the job data. Try again in a minute.'); return; }

  // Version the category files by the run that produced them: cached until the
  // next daily run, never stale after it (cache-bust by version, not by clock)
  VER = encodeURIComponent(INDEX.generated || '');
  if (INDEX.generated) {
    // Older runs wrote no offset; they ran on the UTC CI runner
    var g = INDEX.generated;
    var t = new Date(/[zZ]|[+-]\d\d:?\d\d$/.test(g) ? g : g + 'Z');
    LATEST_RUN = hkDate(t);
    var hh = new Date(t.getTime() + 8 * 3600e3).toISOString().slice(11, 16);
    UPDATED_TEXT = 'Updated ' + (LATEST_RUN === TODAY_HK ? 'today' : LATEST_RUN) + ' ' + hh + ' HKT';
    $('updateDate').textContent = LATEST_RUN + ' ' + hh + ' HKT';
  }

  var sel = $('categorySelect');
  (INDEX.categories || []).forEach(function (c) {
    var o = document.createElement('option'); o.value = c; o.textContent = c; sel.appendChild(o);
  });

  var entries = INDEX.data || [];
  if (!entries.length) { showErr('No data yet. The daily run has not produced any files.'); return; }

  var files = await Promise.all(entries.map(function (e) {
    return fetch(DB + e.file + '?v=' + VER).then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  }));

  // Merge: one object per job (dedup by URL), remembering every category it appears in
  files.forEach(function (d, i) {
    if (!d || !Array.isArray(d.jobs)) return;
    var cat = entries[i].query, list = CAT_JOBS[cat] || (CAT_JOBS[cat] = []), inCat = {};
    d.jobs.forEach(function (j) {
      var k = jobKey(j), canon = BY_KEY[k];
      if (!canon) {
        canon = j; j._k = k; j._id = JOBS.length; j._cats = []; j._relMax = j.relevance || 0;
        BY_KEY[k] = j; JOBS.push(j);
      } else {
        canon._relMax = Math.max(canon._relMax, j.relevance || 0);
      }
      if (canon._cats.indexOf(cat) === -1) canon._cats.push(cat);
      if (!inCat[k]) { inCat[k] = 1; list.push(canon); }
    });
  });
  if (!JOBS.length) { showErr('Could not load the job files. Try again in a minute.'); return; }

  // Hero live line (all categories)
  var week = JOBS.filter(function (j) { var a = ageDays(j); return a !== null && a < 7; }).length;
  var newToday = JOBS.filter(isNew).length;
  $('liveLine').textContent = nf(week) + ' posted this week | ' + nf(newToday) + ' new today' +
    (UPDATED_TEXT ? ' | ' + UPDATED_TEXT : '');

  setupChartDefaults();
  renderPicks();
  search();
  // Coming back the next day: open on the unfinished jobs
  if (JOBS.some(function (j) { return statusOf(j) === 'progress'; })) setTab('progress');
  $('loading').classList.add('hidden');
  $('content').classList.remove('hidden');
}

function showErr(m) {
  $('loadingText').textContent = m;
  $('loadingBlocks').classList.add('hidden');
}

// ==================================================================
// CATEGORY (Search / apply)
// ==================================================================
function search() {
  var cat = $('categorySelect').value;
  ALL_JOBS = cat ? (CAT_JOBS[cat] || []) : JOBS;
  var label = cat || 'All categories';
  $('viewTitle').textContent = cat ? cat + ' jobs in Hong Kong' : 'All categories';
  $('viewSub').textContent = ALL_JOBS.length
    ? nf(ALL_JOBS.length) + ' live ads' + (cat ? '' : ' across ' + Object.keys(CAT_JOBS).length + ' categories') + ', none older than 45 days.'
    : 'No ads in ' + label + ' in the latest run.';
  renderFigures();
  renderCharts();
  PAGE = 1;
  // A category is a request to browse: show its To apply list
  if (TAB !== 'todo') setTab('todo'); else applyFilters();
}

// ==================================================================
// APPLY FIRST
// ==================================================================
function rankPicks() {
  var cands = [];
  JOBS.forEach(function (j) {
    var a = ageDays(j);
    if (a === null || a > 3) return;
    if (j.mandarin === 'Required') return;
    if (j.seniority === 'Director+' || j.seniority === 'Manager') return;
    if (isApplied(j) || isRemoved(j)) return;
    // Data science and data engineering stay out of the picks: DE is ~10% of applications
    // by choice (degree + Spark/Databricks gaps), browse it in the Data Engineer category.
    if (/data scientist|research scientist|data engineer|data engineering|data platform|etl developer/i.test(j.title || '')) return;
    var boost = 0;
    j._cats.forEach(function (c) { boost = Math.max(boost, CAT_BOOST[c] || 0); });
    var score = (j._relMax || 0) * 0.5 + (Number(j.match) || 0) * 0.4 + boost + (AGE_BONUS[a] || 0)
      - (j.mandarin === 'Preferred' ? 8 : 0) + (j.ttps ? 3 : 0);
    cands.push({ j: j, s: score });
  });
  cands.sort(function (x, y) { return y.s - x.s; });
  return cands.slice(0, 8).map(function (c) { return c.j; });
}

function whyLine(j) {
  var have = {}, hits = [];
  (j.skills || []).forEach(function (s) { have[String(s).toLowerCase()] = 1; });
  for (var i = 0; i < PROFILE.length && hits.length < 3; i++) {
    var p = PROFILE[i];
    if (!have[p[0]]) continue;
    if (p[0] === 'bi' && have['power bi']) continue;
    if (p[0] === 'seo' && have['technical seo']) continue;
    hits.push(p[1]);
  }
  var parts = [];
  if (hits.length) parts.push('Asks for ' + hits.join(', '));
  else if (j._cats && j._cats.length) parts.push('Fits ' + j._cats[0]);
  if (!j.mandarin) parts.push('no Chinese mentioned');
  else if (j.mandarin === 'Preferred') parts.push('Chinese preferred, not required');
  if (j.ttps) parts.push('TTPS-friendly employer');
  return parts.join('; ');
}

function renderPicks() {
  var picks = rankPicks();
  $('applyFirstCount').textContent = picks.length ? 'Top ' + picks.length + ' of the last 4 days' : '';
  $('picksEmpty').classList.toggle('hidden', picks.length > 0);
  var sep = '<span aria-hidden="true" class="text-rule-strong px-1.5">|</span>';
  $('picksList').innerHTML = picks.map(function (j, i) {
    var p = jobParts(j);
    var meta = [p.salaryShort, p.level, p.mode].filter(Boolean).join(sep);
    return '<li data-row="' + j._id + '" class="' + rowCls(j) + ' px-4 md:px-6 py-4 grid grid-cols-[1.75rem_1fr] md:grid-cols-[2.5rem_1fr_auto] gap-x-3 md:gap-x-4 gap-y-2 items-start">'
      + '<span class="font-serif text-2xl leading-none text-accent-ink num pt-0.5" aria-hidden="true">' + (i + 1) + '</span>'
      + '<div class="min-w-0">'
      +   '<p class="text-[0.9375rem] md:text-base leading-snug">' + p.titleLink + '</p>'
      +   p.status
      +   '<p class="mt-0.5 text-sm text-ink-2">' + p.company + sep + p.posted + '</p>'
      +   (meta ? '<p class="mt-1 text-sm text-ink-2">' + meta + '</p>' : '')
      +   '<p class="mt-1 text-sm text-ink-3">' + esc(whyLine(j)) + '</p>'
      + '</div>'
      + '<div class="col-start-2 md:col-start-auto md:pt-0.5">' + pipeHtml(j, false) + contactLinks(j, false) + '</div>'
      + '</li>';
  }).join('');
}

// ==================================================================
// KEY FIGURES (selected category, independent of table filters)
