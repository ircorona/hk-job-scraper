// ==================================================================
// CHARTS
// ==================================================================
function setupChartDefaults() {
  if (typeof Chart === 'undefined') return;
  var d = Chart.defaults;
  d.font.family = 'Inter, system-ui, sans-serif';
  d.font.size = 12;
  d.color = C.ink2;
  d.borderColor = C.rule;
  if (REDUCED_MOTION) d.animation = false; else d.animation.duration = 250;
  d.maintainAspectRatio = false;
  d.plugins.legend.display = false;
  Object.assign(d.plugins.tooltip, {
    backgroundColor: C.ink, titleColor: C.paper, bodyColor: C.paper, padding: 8, cornerRadius: 4,
    displayColors: false, titleFont: { weight: '600', size: 12 }, bodyFont: { size: 12 }, caretSize: 5
  });
  Object.assign(d.elements.bar, { borderRadius: 3, borderSkipped: 'start' });
  d.datasets.bar.maxBarThickness = 22;
  d.datasets.bar.categoryPercentage = 0.8;
  d.datasets.bar.barPercentage = 0.86;
  d.scale.grid.display = false;
  d.scale.border = Object.assign(d.scale.border || {}, { display: false });
}

// Direct labels at the end of horizontal bars (or on top of vertical ones).
// The highlighted bar's label is set in ink and semibold.
function endLabels(text, strong, vertical) {
  strong = strong || function () { return false; };
  return {
    id: 'endLabels',
    afterDatasetsDraw: function (chart) {
      var ctx = chart.ctx, meta = chart.getDatasetMeta(0);
      ctx.save();
      ctx.textBaseline = vertical ? 'bottom' : 'middle';
      ctx.textAlign = vertical ? 'center' : 'left';
      chart.data.datasets[0].data.forEach(function (val, i) {
        var el = meta.data[i];
        if (!el) return;
        var label = text(i, val);
        if (label === '') return;
        var s = strong(i);
        ctx.font = (s ? 600 : 500) + ' ' + (vertical ? 11 : 12) + 'px Inter, system-ui, sans-serif';
        ctx.fillStyle = s ? C.ink : C.ink2;
        if (vertical) ctx.fillText(label, el.x, el.y - 4);
        else ctx.fillText(label, el.x + 6, el.y);
      });
      ctx.restore();
    }
  };
}
function yCats(extra) {
  return { grid: { display: false }, ticks: Object.assign({ color: C.ink2, font: { size: 12 }, padding: 6, autoSkip: false }, extra || {}) };
}
function xHidden(max) { return { display: false, beginAtZero: true, suggestedMax: max }; }
function colorsFor(n, hi) { var a = []; for (var i = 0; i < n; i++) a.push(i === hi ? C.accent : C.neutral); return a; }
function hoverFor(n, hi) { var a = []; for (var i = 0; i < n; i++) a.push(i === hi ? C.accentInk : C.neutralHover); return a; }
function setEmpty(canvasId, emptyId, isEmpty) {
  $(canvasId).classList.toggle('hidden', isEmpty);
  if (emptyId) $(emptyId).classList.toggle('hidden', !isEmpty);
}
function hbar(id, labels, values, hi, labelFn, tooltipFn, fullNames) {
  var max = Math.max.apply(null, values.concat([1]));
  charts[id] = new Chart($(id), {
    type: 'bar',
    data: { labels: labels, datasets: [{ data: values, backgroundColor: colorsFor(values.length, hi), hoverBackgroundColor: hoverFor(values.length, hi) }] },
    options: {
      indexAxis: 'y',
      layout: { padding: { left: 6 } },
      plugins: { tooltip: { callbacks: {
        title: function (items) { return fullNames ? fullNames[items[0].dataIndex] : items[0].label; },
        label: tooltipFn
      } } },
      scales: {
        x: xHidden(max * (window.innerWidth < 480 ? 1.45 : 1.25)),
        y: yCats({
          font: function (c) { return { size: 12, weight: c.index === hi ? '600' : '400' }; },
          color: function (c) { return c.index === hi ? C.ink : C.ink2; }
        })
      }
    },
    plugins: [endLabels(labelFn, function (i) { return i === hi; })]
  });
}

var BRACKETS = ['<HK$15K', 'HK$15-25K', 'HK$25-35K', 'HK$35-50K', 'HK$50-80K', 'HK$80K+'];
function bracketIndex(s) {
  if (s < 15000) return 0;
  if (s < 25000) return 1;
  if (s < 35000) return 2;
  if (s < 50000) return 3;
  if (s < 80000) return 4;
  return 5;
}

function renderCharts() {
  Object.keys(charts).forEach(function (k) { charts[k].destroy(); });
  charts = {};
  if (typeof Chart === 'undefined') {
    $('chartsUnavailable').classList.remove('hidden');
    return;
  }
  var n = ALL_JOBS.length || 1;
  var pct = function (v, t) { return Math.round(v / (t || 1) * 100); };

  // 1. When were they posted? Last 14 HK days, today highlighted
  var dayKeys = [], dayLabels = [], counts = {};
  var base0 = Date.parse(TODAY_HK);
  for (var d = 13; d >= 0; d--) {
    var dt = new Date(base0 - d * 86400e3);
    var key = dt.toISOString().slice(0, 10);
    dayKeys.push(key);
    dayLabels.push(d === 0 ? 'Today' : dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }));
    counts[key] = 0;
  }
  ALL_JOBS.forEach(function (j) { if (j.date && counts.hasOwnProperty(j.date)) counts[j.date]++; });
  var dayVals = dayKeys.map(function (k) { return counts[k]; });
  var in14 = dayVals.reduce(function (a, b) { return a + b; }, 0);
  setEmpty('postedChart', 'postedEmpty', in14 === 0);
  $('postedSub').textContent = nf(in14) + ' of ' + nf(ALL_JOBS.length) + ' ads were posted in the last 14 Hong Kong days, ' + nf(dayVals[13]) + ' of them today (orange).';
  $('postedChart').setAttribute('aria-label', 'Jobs posted per day, last 14 days: ' +
    dayKeys.map(function (k, i) { return dayLabels[i] + ' ' + dayVals[i]; }).join(', '));
  if (in14) {
    charts.postedChart = new Chart($('postedChart'), {
      type: 'bar',
      data: { labels: dayLabels, datasets: [{ data: dayVals, backgroundColor: colorsFor(14, 13), hoverBackgroundColor: hoverFor(14, 13) }] },
      options: {
        layout: { padding: { top: 18 } },
        plugins: { tooltip: { callbacks: { title: function (it) { return dayKeys[it[0].dataIndex]; }, label: function (c) { return nf(c.raw) + ' posted'; } } } },
        scales: {
          x: { grid: { display: false }, ticks: { color: C.ink2, font: { size: 11 }, maxRotation: 0, autoSkip: false,
            // every other day, counted back from today so "Today" is always labelled
            callback: function (v, i) { return (13 - i) % (window.innerWidth < 640 ? 3 : 2) === 0 ? dayLabels[i] : ''; },
            font: function (c) { return { size: 11, weight: c.index === 13 ? '600' : '400' }; } } },
          y: { display: false, beginAtZero: true }
        }
      },
      plugins: [endLabels(function (i, v) { return v ? nf(v) : ''; }, function (i) { return i === 13; }, true)]
    });
  }

  // 2. Do they need Chinese? Not mentioned is the answer worth seeing
  var req = 0, pref = 0, none = 0;
  ALL_JOBS.forEach(function (j) {
    if (j.mandarin === 'Required') req++;
    else if (j.mandarin) pref++;
    else none++;
  });
  var chTotal = req + pref + none;
  $('chineseSub').textContent = pct(none, chTotal) + '% of ads do not mention Chinese at all. Read from the full ad text; Cantonese or Mandarin both count.';
  $('chineseChart').setAttribute('aria-label', 'Chinese required ' + req + ', preferred or mentioned ' + pref + ', not mentioned ' + none);
  hbar('chineseChart', ['Required', 'Preferred or mentioned', 'Not mentioned'], [req, pref, none], 2,
    function (i, v) { return nf(v) + ' (' + pct(v, chTotal) + '%)'; },
    function (c) { return nf(c.raw) + ' ads (' + pct(c.raw, chTotal) + '%)'; });

  // 3. Where is the money? Published salaries only, median bracket highlighted
  var real = ALL_JOBS.filter(hasRealSalary).map(function (j) { return j.salary_num; });
  var bVals = [0, 0, 0, 0, 0, 0];
  real.forEach(function (s) { bVals[bracketIndex(s)]++; });
  var med = median(real);
  var enough = real.length >= 3;
  setEmpty('salaryChart', 'salaryEmpty', !enough);
  $('salaryTitle').textContent = enough ? 'Half of posted salaries are below HK$' + nf(med) : 'Where is the money?';
  $('salarySub').textContent = enough
    ? 'Monthly pay in the ' + nf(real.length) + ' of ' + nf(ALL_JOBS.length) + ' ads that publish it. The bracket with the median is in orange. Estimates are left out.'
    : 'Only ' + nf(real.length) + ' of ' + nf(ALL_JOBS.length) + ' ads publish a salary. Estimates are left out.';
  if (enough) {
    $('salaryChart').setAttribute('aria-label', 'Ads by published monthly salary: ' + BRACKETS.map(function (b, i) { return b + ' ' + bVals[i]; }).join(', '));
    hbar('salaryChart', BRACKETS, bVals, bracketIndex(med),
      function (i, v) { return nf(v) + ' (' + pct(v, real.length) + '%)'; },
      function (c) { return nf(c.raw) + ' ads (' + pct(c.raw, real.length) + '%)'; });
  }

  // 4. Which skills do they ask for? Top 10, the most asked highlighted
  var sk = {};
  ALL_JOBS.forEach(function (j) { (j.skills || []).forEach(function (s) { sk[s] = (sk[s] || 0) + 1; }); });
  var top = Object.keys(sk).map(function (k) { return [k, sk[k]]; }).sort(function (a, b) { return b[1] - a[1]; }).slice(0, 10);
  setEmpty('skillsChart', 'skillsEmpty', !top.length);
  if (top.length) {
    $('skillsSub').textContent = top[0][0].charAt(0).toUpperCase() + top[0][0].slice(1) + ' leads: ' + pct(top[0][1], n) + '% of ads mention it. Jobs that mention each skill.';
    $('skillsChart').setAttribute('aria-label', 'Most requested skills: ' + top.map(function (t) { return t[0] + ' ' + t[1]; }).join(', '));
    hbar('skillsChart', top.map(function (t) { return t[0]; }), top.map(function (t) { return t[1]; }), 0,
      function (i, v) { return nf(v); },
      function (c) { return nf(c.raw) + ' ads mention it (' + pct(c.raw, n) + '%)'; });
  }

  // 5. Who is hiring? Top 8 named employers
  var cc = {};
  ALL_JOBS.forEach(function (j) { if (j.company && j.company !== 'Confidential') cc[j.company] = (cc[j.company] || 0) + 1; });
  var emps = Object.keys(cc).map(function (k) { return [k, cc[k]]; }).sort(function (a, b) { return b[1] - a[1]; }).slice(0, 8);
  var okEmp = emps.length >= 3;
  setEmpty('employersChart', 'employersEmpty', !okEmp);
  if (okEmp) {
    var maxLen = window.innerWidth < 480 ? 20 : 34;
    $('employersSub').textContent = emps[0][0] + ' has the most ads (' + nf(emps[0][1]) + '). Confidential employers are left out.';
    $('employersChart').setAttribute('aria-label', 'Employers with the most ads: ' + emps.map(function (e) { return e[0] + ' ' + e[1]; }).join(', '));
    hbar('employersChart', emps.map(function (e) { return e[0].length > maxLen ? e[0].slice(0, maxLen - 1).trim() + '…' : e[0]; }),
      emps.map(function (e) { return e[1]; }), 0,
      function (i, v) { return nf(v); },
      function (c) { return nf(c.raw) + ' open ads'; },
      emps.map(function (e) { return e[0]; }));
  }
}

// ==================================================================
// JOB PARTS (every scraped field escaped here, once)
// ==================================================================
// En and em dashes in scraped salary ranges become a plain hyphen
var DASHES = new RegExp('\\s*[' + String.fromCharCode(8211, 8212) + ']\\s*', 'g');
function salaryShort(j) {
  return String(j.salary || '')
    .replace(DASHES, ' - ')
    .replace(/\s*per month/i, ' a month')
    .replace(/^HKD\$\s*/i, 'HK$')
    .trim();
}
function postedText(j) {
  var a = ageDays(j);
  if (a === null) return 'Date unknown';
  if (a === 0) return 'Today';
  if (a === 1) return 'Yesterday';
  return a + ' days ago';
}
function jobParts(j) {
  var url = safeUrl(j.url), title = esc(j.title);
  var titleLink = url !== '#'
    ? '<a href="' + url + '" target="_blank" rel="noopener noreferrer" data-step="read" data-id="' + j._id + '" class="font-medium text-ink hover:text-accent-ink hover:underline underline-offset-2 transition-colors">' + title + '</a>'
    : '<span class="font-medium text-ink">' + title + '</span>';
  var a = ageDays(j);
  var newB = isNew(j) ? ' <span class="badge border border-ink text-ink">New</span>' : '';
  var posted = '<span class="num ' + (a === null ? 'text-ink-3' : (a <= 1 ? 'text-ink font-medium' : 'text-ink-2')) + '"' +
    (j.date ? ' title="Posted ' + esc(j.date) + (j.first_seen ? ', first seen ' + esc(j.first_seen) : '') + '"' : '') + '>' +
    postedText(j) + '</span>' + newB;

  var chinese = '';
  if (j.mandarin === 'Required') chinese = '<span class="badge badge-warn" title="The ad requires Chinese (Cantonese or Mandarin)">Chinese required</span>';
  else if (j.mandarin === 'Preferred') chinese = '<span class="badge badge-neutral" title="Chinese is a plus, not required">Chinese preferred</span>';
  else if (j.mandarin) chinese = '<span class="badge badge-neutral" title="The ad mentions Chinese">Chinese mentioned</span>';
  var ttps = j.ttps ? '<span class="badge badge-outline" title="Employer known to hire internationally, or the ad mentions visa support">TTPS</span>' : '';

  var sal = salaryShort(j), salHtml, salTxt;
  if (hasRealSalary(j)) { salHtml = '<span class="text-ink font-medium">' + esc(sal) + '</span>'; salTxt = esc(sal); }
  else if (j.salary_est) {
    var tip = 'Estimate, ' + (j.salary_confidence || 'low').toLowerCase() + ' confidence' + (j.salary_basis ? ': ' + j.salary_basis : '');
    salHtml = '<span class="text-ink-3" title="' + esc(tip) + '">' + esc(sal) + ' <span class="text-xs">est</span></span>';
    salTxt = '<span class="text-ink-3">' + esc(sal) + ' est</span>';
  } else { salHtml = '<span class="text-ink-3">Not given</span>'; salTxt = ''; }

  var applied = isApplied(j);
  var appliedBtn = '<button type="button" class="applied-btn" data-applied="' + j._id + '" aria-pressed="' + applied + '"' +
    ' aria-label="' + (applied ? 'Applied to ' : 'Mark applied: ') + title + '">' +
    (applied ? '<span aria-hidden="true">&#10003;</span> Applied' : 'Mark applied') + '</button>';

  return {
    url: url, title: title, titleLink: titleLink, company: esc(j.company || 'Company not given'),
    posted: posted, chinese: chinese, ttps: ttps, salHtml: salHtml, salaryShort: salTxt,
    level: esc(j.seniority || ''), mode: esc(j.work_mode || ''),
    match: Number(j.match) || 0, source: esc(SRC_NAMES[j.source] || j.source || ''),
    appliedBtn: appliedBtn, applied: applied, pipe: pipeHtml(j, true), pipeFull: pipeHtml(j, false),
    id: j._id, rowCls: rowCls(j), status: statusHtml(j),
    contacts: contactLinks(j, true), contactsFull: contactLinks(j, false)
  };
}

// ==================================================================
// TABLE
// ==================================================================
function applyFilters(keepPage) {
  var q = ($('searchInput').value || '').toLowerCase().trim();
  var sen = $('seniorityFilter').value;
  var wm = $('workModeFilter').value;
  var src = $('sourceFilter').value;
  var ttps = $('ttpsFilter').checked;
  var posted = $('postedFilter').value;
  var lang = $('langFilter').value;
  var onlyNew = $('newFilter').checked;

  function matchesQ(j) {
    return !q || String(j.title || '').toLowerCase().indexOf(q) !== -1 || String(j.company || '').toLowerCase().indexOf(q) !== -1;
  }
  // To apply is computed on every call, so its tab count is right whichever tab is open
  var todo = ALL_JOBS.filter(function (j) {
    if (statusOf(j) !== 'todo') return false;
    if (posted) { var a = ageDays(j); if (a === null || a >= Number(posted)) return false; }
    if (lang === 'no-req' && j.mandarin === 'Required') return false;
    if (lang === 'none' && j.mandarin) return false;
    if (onlyNew && !isNew(j)) return false;
    if (!matchesQ(j)) return false;
    if (sen && j.seniority !== sen) return false;
    if (wm && j.work_mode !== wm) return false;
    if (src && j.source !== src) return false;
    if (ttps && !j.ttps) return false;
    return true;
  });
  TODO_N = todo.length;

  if (TAB === 'todo') {
    FILTERED = todo;
    FILTERED.sort(compareJobs);
  } else {
    // In progress, Applied, Removed: every job with that status, all categories, search only
    FILTERED = JOBS.filter(function (j) { return statusOf(j) === TAB && matchesQ(j); });
    FILTERED.sort(function (a, b) {
      if (SORT_KEY !== 'date') return compareJobs(a, b);
      var va = activityOf(a), vb = activityOf(b);
      return (SORT_ASC ? va.localeCompare(vb) : vb.localeCompare(va)) || String(a.title).localeCompare(String(b.title));
    });
  }

  if (!keepPage) PAGE = 1;
  renderTable();
}

function compareJobs(a, b) {
    var va = a[SORT_KEY], vb = b[SORT_KEY];
    if (SORT_KEY === 'date') {
      va = va || ''; vb = vb || '';
      // undated always last; same day -> better category fit first
      if (!va || !vb) return (vb ? 1 : 0) - (va ? 1 : 0);
      if (va !== vb) return SORT_ASC ? va.localeCompare(vb) : vb.localeCompare(va);
      return (b.relevance || 0) - (a.relevance || 0) || (b.match || 0) - (a.match || 0);
    }
    if (SORT_KEY === 'seniority') { va = LEVEL_RANK[va] || 0; vb = LEVEL_RANK[vb] || 0; }
    if (SORT_KEY === 'salary_num' || SORT_KEY === 'match') { va = Number(va) || 0; vb = Number(vb) || 0; }
    if (typeof va === 'number' && typeof vb === 'number') return SORT_ASC ? va - vb : vb - va;
    va = String(va || '').toLowerCase(); vb = String(vb || '').toLowerCase();
    if (!va || !vb) return (vb ? 1 : 0) - (va ? 1 : 0);
    return SORT_ASC ? va.localeCompare(vb) : vb.localeCompare(va);
}

function renderTable() {
  var total = FILTERED.length;
  var totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
  if (PAGE > totalPages) PAGE = totalPages;
  var start = (PAGE - 1) * PER_PAGE;
  var page = FILTERED.slice(start, start + PER_PAGE);
  var parts = page.map(jobParts);

  $('jobTableBody').innerHTML = parts.map(function (p) {
    return '<tr data-row="' + p.id + '" class="' + p.rowCls + ' align-top hover:bg-paper transition-colors">'
      + '<td class="pl-4 pr-3 py-3 whitespace-nowrap">' + p.posted + '<div class="mt-1 text-xs text-ink-3">' + p.source + '</div></td>'
      + '<td class="px-3 py-3 min-w-[14rem] leading-snug"><div>' + p.titleLink + '</div>' + p.status
      +   ((p.chinese || p.ttps) ? '<div class="mt-1 flex flex-wrap gap-1">' + p.chinese + p.ttps + '</div>' : '')
      +   '<div class="mt-2">' + p.pipe + '</div></td>'
      + '<td class="px-3 py-3 min-w-[8rem] max-w-[12rem] text-ink-2 leading-snug">' + p.company + p.contacts + '</td>'
      + '<td class="px-3 py-3 text-right num max-w-[9.5rem]">' + p.salHtml + '</td>'
      + '<td class="px-3 py-3 text-ink-2 whitespace-nowrap">' + p.level + '</td>'
      + '<td class="px-3 py-3 text-ink-2 whitespace-nowrap">' + p.mode + '</td>'
      + '<td class="pl-3 pr-4 py-3 text-right num text-ink">' + p.match + '</td>'
      + '</tr>';
  }).join('');

  var sep = '<span aria-hidden="true" class="text-rule-strong px-1">|</span>';
  $('jobCards').innerHTML = parts.map(function (p) {
    var meta = [p.level, p.mode, p.source, '<span class="num">Match ' + p.match + '</span>'].filter(Boolean).join(sep);
    return '<li data-row="' + p.id + '" class="' + p.rowCls + ' px-4 py-4">'
      + '<p class="text-sm text-ink-2">' + p.posted + '</p>'
      + '<p class="mt-1 text-[0.9375rem] leading-snug">' + p.titleLink + '</p>' + p.status
      + '<p class="text-sm text-ink-2 mt-0.5">' + p.company + '</p>'
      + '<p class="text-sm mt-2 num">' + p.salHtml + '</p>'
      + ((p.chinese || p.ttps) ? '<div class="flex flex-wrap gap-1.5 mt-2">' + p.chinese + p.ttps + '</div>' : '')
      + '<p class="text-sm text-ink-2 mt-2">' + meta + '</p>'
      + '<div class="mt-3">' + p.pipeFull + p.contactsFull + '</div></li>';
  }).join('');

  $('jobsEmpty').textContent = TAB === 'progress'
    ? 'Nothing in progress. Open a job description from To apply and it shows up here.'
    : TAB === 'applied'
      ? 'No applications marked in this browser yet. Click 3 Applied on a job once you have sent it.'
      : TAB === 'removed'
        ? 'Nothing removed. Use Remove on a job that is not for you and it disappears from the lists.'
        : 'No jobs match these filters. Try a wider posted window or "Any language".';
  $('jobsEmpty').classList.toggle('hidden', total > 0);
  $('tableWrap').classList.toggle('lg:block', total > 0);
  var showing = total > 0 ? nf(start + 1) + ' to ' + nf(Math.min(start + PER_PAGE, total)) + ' of ' + nf(total) + ' jobs' : '0 jobs';
  $('tableInfo').textContent = showing;
  if (TAB === 'todo') {
    $('filterSummary').textContent = nf(total) + ' of ' + nf(ALL_JOBS.length) + ' match the filters';
    $('tabNote').textContent = '';
  } else {
    $('filterSummary').textContent = '';
    var note = TAB === 'progress'
      ? 'Read or customized, not applied yet. All categories, last touched first.'
      : TAB === 'removed'
        ? 'Not for you: hidden from Apply first and the other tabs. Restore puts one back.'
        : 'All categories, most recent first. Follow up once at day 7 if there is no reply.';
    if (TAB === 'applied') {
      var gone = Object.keys(APPLIED).filter(function (k) { return !BY_KEY[k]; }).length;
      if (gone) note += ' ' + nf(gone) + ' earlier ' + (gone === 1 ? 'application is' : 'applications are') + ' not listed because the ad has left the data.';
    }
    $('tabNote').textContent = note;
  }
  renderCounts();
  $('jumpCount').textContent = nf(total);
  $('pageInfo').textContent = 'Page ' + PAGE + ' of ' + totalPages;
  $('prevPageBtn').disabled = PAGE <= 1;
  $('nextPageBtn').disabled = PAGE >= totalPages;
}

function sortTable(key) {
  if (SORT_KEY === key) SORT_ASC = !SORT_ASC;
  else { SORT_KEY = key; SORT_ASC = !!TEXT_KEYS[key]; }
  document.querySelectorAll('th[data-sort]').forEach(function (th) {
    var on = th.getAttribute('data-sort') === SORT_KEY;
    th.setAttribute('aria-sort', on ? (SORT_ASC ? 'ascending' : 'descending') : 'none');
    var arrow = th.querySelector('.sort-arrow');
    if (arrow) arrow.textContent = on ? (SORT_ASC ? '▲' : '▼') : '';
  });
  applyFilters();
}

function changePage(delta) {
  var totalPages = Math.max(1, Math.ceil(FILTERED.length / PER_PAGE));
  var p = PAGE + delta;
  if (p < 1 || p > totalPages) return;
  PAGE = p;
  renderTable();
  $('jobs').scrollIntoView({ behavior: REDUCED_MOTION ? 'auto' : 'smooth', block: 'start' });
}

// ==================================================================
// EXCEL (SheetJS loaded only when someone exports)
// ==================================================================
var XLSX_SRC = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
var xlsxLoading = null;
function loadXlsx() {
  if (window.XLSX) return Promise.resolve(window.XLSX);
  if (!xlsxLoading) {
    xlsxLoading = new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = XLSX_SRC; s.async = true;
      s.onload = function () { window.XLSX ? resolve(window.XLSX) : reject(new Error('XLSX global missing')); };
      s.onerror = function () { reject(new Error('XLSX script failed to load')); };
      document.head.appendChild(s);
    }).catch(function (e) { xlsxLoading = null; throw e; });
  }
  return xlsxLoading;
}
async function downloadExcel() {
  var btn = $('downloadExcelBtn'), label = btn.querySelector('.btn-label'), original = label.textContent;
  btn.disabled = true; label.textContent = 'Preparing…';
  try {
    await loadXlsx();
    var rows = FILTERED.map(function (j) {
      return {
        Posted: j.date || '', 'First seen': j.first_seen || '', Chinese: j.mandarin || '',
        'Match%': j.match, Title: j.title, Company: j.company, Salary: j.salary,
        'Salary estimated': j.salary_est ? 'Yes' : 'No', Seniority: j.seniority || '',
        'Work Mode': j.work_mode || '', TTPS: j.ttps ? 'Yes' : 'No', Applied: isApplied(j) ? 'Yes' : 'No',
        Skills: (j.skills || []).join(', '), Source: j.source, URL: j.url
      };
    });
    var ws = XLSX.utils.json_to_sheet(rows), wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'HK Jobs');
    XLSX.writeFile(wb, 'hk_jobs_' + TODAY_HK + '.xlsx');
    label.textContent = original;
  } catch (e) {
    label.textContent = 'Export failed, try again';
    setTimeout(function () { label.textContent = original; }, 4000);
  } finally { btn.disabled = false; }
}

// ==================================================================
// EVENTS
// ==================================================================
function wire() {
  // The results start ~1,700px below the button (under Apply first), so a bare
  // re-render looked like the button did nothing. Take the user to them.
  $('categoryForm').addEventListener('submit', function (e) {
    e.preventDefault();
    if (!JOBS.length) return;
    search();
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    $('viewTitle').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  });
  $('categorySelect').addEventListener('change', function () { if (JOBS.length) search(); });
  $('searchInput').addEventListener('input', function () { applyFilters(); });
  ['postedFilter', 'langFilter', 'newFilter', 'seniorityFilter', 'workModeFilter', 'sourceFilter', 'ttpsFilter'].forEach(function (id) {
    $(id).addEventListener('change', function () { applyFilters(); });
  });
  document.querySelectorAll('.tab[data-tab]').forEach(function (b) {
    b.addEventListener('click', function () { setTab(b.getAttribute('data-tab')); });
  });
  $('backupBtn').addEventListener('click', backupMarks);
  $('restoreInput').addEventListener('change', function () {
    if (this.files && this.files[0]) restoreMarks(this.files[0]);
    this.value = '';
  });
  $('toastAction').addEventListener('click', function () {
    var fn = toastUndo; hideToast();
    if (fn) fn();
  });
  $('prevPageBtn').addEventListener('click', function () { changePage(-1); });
  $('nextPageBtn').addEventListener('click', function () { changePage(1); });
  $('downloadExcelBtn').addEventListener('click', downloadExcel);
  document.querySelectorAll('[data-sort-btn]').forEach(function (b) {
    b.addEventListener('click', function () { sortTable(b.getAttribute('data-sort-btn')); });
  });
  // One delegated handler for every Mark applied button (picks, rows, cards)
  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;
    var b = e.target.closest('[data-step]');
    if (b) { onStep(b.getAttribute('data-step'), Number(b.getAttribute('data-id'))); return; }
    var rmb = e.target.closest('[data-remove]');
    if (rmb) { onRemove(Number(rmb.getAttribute('data-remove'))); return; }
    var r = e.target.closest('[data-reset]');
    if (r) {
      var j = JOBS[Number(r.getAttribute('data-reset'))]; if (!j) return;
      var before = stageOf(j);
      resetStage(j); refreshJob(j._id); scheduleMove(j._id);
      toast('Moved back to To apply.', 0, function () {
        STAGE[j._k] = before; saveStage(); refreshJob(j._id); scheduleMove(j._id); toast('Undone.');
      });
      return;
    }
    // "Finish them first": open the In progress tab and go to the list
    if (e.target.closest('#continueLink')) {
      e.preventDefault();
      setTab('progress');
      $('jobs').scrollIntoView({ behavior: REDUCED_MOTION ? 'auto' : 'smooth', block: 'start' });
    }
  });
}

function boot() { wire(); init(); }
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
</script>
