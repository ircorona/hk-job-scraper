---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hong Kong Jobs | Fresh data and analytics roles, updated daily',
  description = 'Fresh Hong Kong job ads for data, BI, risk, web and automation roles: posted dates, Chinese-language requirements, real salaries and who is hiring. Updated daily from JobsDB, LinkedIn, Indeed and company career sites.',
} = Astro.props;

const pageURL = 'https://climbthesearches.com/hk-jobs/';
---

<!doctype html>
<html lang="en-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Irmin Corona" />
    <!-- Personal tool, not for search engines. OG tags stay so the LinkedIn
         Featured link still renders a preview card. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF8F5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:locale" content="en_HK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🇭🇰</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- Inter (UI) + Newsreader 500 at optical size 72 (display serif), same as the Mexico dashboard -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@72,500&display=swap" rel="stylesheet" />
    <!-- Chart.js pinned and deferred: chart code runs after DOMContentLoaded.
         SheetJS (xlsx) is injected on demand by loadXlsx() when someone exports. -->
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased">
    <a href="#jobs" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:px-3 focus:py-2 focus:rounded-lg focus:border focus:border-ink">Skip to jobs</a>
    <slot />
  </body>
</html>
