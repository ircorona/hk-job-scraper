---
// Job list: cards on phones, table from md. Rows are rendered by renderTable() in index.astro.
const th = 'bg-well px-3 py-3 font-medium border-b border-rule whitespace-nowrap';
const cols = [
  { key: 'date', label: 'Posted', cls: 'pl-4 rounded-tl-[10px]' },
  { key: 'title', label: 'Role', cls: '' },
  { key: 'company', label: 'Company', cls: '' },
  { key: 'salary_num', label: 'Salary', cls: 'text-right' },
  { key: 'seniority', label: 'Level', cls: '' },
  { key: 'work_mode', label: 'Mode', cls: '' },
  // Last column: Source moved under Posted and the pipeline under the title, so the
  // table fits the page width (a 9th column pushed Applied off the right edge).
  { key: 'match', label: 'Match', cls: 'text-right pr-4 rounded-tr-[10px]' },
];
---

<div class="bg-surface border border-rule rounded-[10px] overflow-hidden mb-10 md:mb-12">
  <ul id="jobCards" role="list" class="lg:hidden divide-y divide-rule"></ul>
  <div id="tableWrap" class="hidden lg:block overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">Hong Kong job ads. Column headers sort the list.</caption>
      <thead class="text-ink-2 select-none">
        <tr class="text-left">
          {cols.map((c) => (
            <th scope="col" aria-sort={c.key === 'date' ? 'descending' : 'none'} data-sort={c.key} class={`${th} ${c.cls}`}>
              <button type="button" class="th-btn" data-sort-btn={c.key}>
                {c.label} <span class="text-[10px] text-ink-3 sort-arrow" aria-hidden="true">{c.key === 'date' ? '▼' : ''}</span>
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody id="jobTableBody" class="divide-y divide-rule"></tbody>
    </table>
  </div>
  <p id="jobsEmpty" class="hidden px-4 py-8 text-center text-sm text-ink-2">No jobs match these filters. Try a wider posted window or "Any language".</p>
  <div class="px-4 py-3 border-t border-rule flex flex-col sm:flex-row items-center justify-between gap-3">
    <p id="tableInfo" class="text-sm text-ink-2 num">0 jobs</p>
    <div class="flex items-center gap-2">
      <button type="button" id="prevPageBtn" class="btn h-9 px-3 rounded-lg border border-rule-strong text-sm font-medium text-ink hover:bg-well disabled:opacity-40 disabled:cursor-not-allowed">Previous</button>
      <span id="pageInfo" class="text-sm text-ink-2 num px-1">Page 1 of 1</span>
      <button type="button" id="nextPageBtn" class="btn h-9 px-3 rounded-lg border border-rule-strong text-sm font-medium text-ink hover:bg-well disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
    </div>
    <button id="downloadExcelBtn" type="button" class="btn inline-flex items-center gap-2 h-9 px-4 rounded-lg border border-ink text-ink text-sm font-medium hover:bg-ink hover:text-paper disabled:opacity-60 disabled:cursor-wait">
      <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14m0 0l-4-4m4 4l4-4M4 19h16"/></svg>
      <span class="btn-label">Download Excel</span>
    </button>
  </div>
</div>
