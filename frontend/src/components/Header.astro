---
// Top nav (wordmark + profile links) and the hero: headline, live line, builder credit, category picker.
const LI = 'https://www.linkedin.com/in/irmin-corona/';
---

<nav class="border-b border-rule" aria-label="Site">
  <div class="max-w-6xl mx-auto px-4 md:px-6 h-14 flex items-center justify-between gap-4">
    <p class="flex items-baseline gap-2 min-w-0">
      <a href="https://climbthesearches.com/" class="hidden sm:inline text-sm text-ink-2 hover:text-accent-ink transition-colors whitespace-nowrap">ClimbTheSearches</a>
      <span class="hidden sm:inline text-rule-strong" aria-hidden="true">/</span>
      <span class="font-serif text-xl leading-none text-ink whitespace-nowrap">Hong Kong jobs</span>
    </p>
    <div class="flex items-center gap-1">
      <a href={LI} target="_blank" rel="noopener noreferrer" class="p-2 text-ink-2 hover:text-accent-ink transition-colors" aria-label="Irmin Corona on LinkedIn">
        <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/ircorona/hk-job-scraper" target="_blank" rel="noopener noreferrer" class="p-2 text-ink-2 hover:text-accent-ink transition-colors" aria-label="Source code on GitHub">
        <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://climbthesearches.com/" class="p-2 text-ink-2 hover:text-accent-ink transition-colors" aria-label="ClimbTheSearches home">
        <svg class="w-[18px] h-[18px]" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      </a>
    </div>
  </div>
</nav>

<header class="max-w-6xl mx-auto px-4 md:px-6 pt-10 md:pt-16 pb-8 md:pb-10">
  <p class="text-sm font-medium text-accent-ink">Hong Kong job market</p>
  <h1 class="mt-3 max-w-4xl font-serif text-[clamp(2rem,1.2rem+3.4vw,3.25rem)] leading-[1.08] tracking-[-0.015em] text-ink">Fresh Hong Kong jobs worth applying to today</h1>
  <p class="mt-4 max-w-2xl text-base md:text-lg leading-relaxed text-ink-2">Data, BI, risk, web and automation roles from JobsDB, LinkedIn, Indeed and company career sites. Newest first, with Chinese-language asks flagged before you open the ad.</p>
  <p class="mt-4 text-sm text-ink-2">
    <span id="liveLine" class="num" aria-live="polite">Updated daily</span>
    <span class="block sm:inline sm:ml-3 sm:pl-3 sm:border-l sm:border-rule-strong">Built by <a href={LI} target="_blank" rel="noopener noreferrer" class="font-medium text-ink underline decoration-rule-strong underline-offset-4 hover:text-accent-ink hover:decoration-accent-ink transition-colors">Irmin Corona</a>, data analyst</span>
  </p>

  <form id="categoryForm" class="mt-8 sm:bg-surface sm:border sm:border-rule sm:rounded-[10px] sm:p-4 md:p-5" role="search" aria-label="Choose a category">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 md:gap-4 items-end">
      <div>
        <label for="categorySelect" class="block text-sm font-medium text-ink-2 mb-1.5">Category</label>
        <select id="categorySelect" name="category" class="field w-full h-12 text-base">
          <option value="">All categories</option>
        </select>
      </div>
      <button id="searchBtn" type="submit" class="btn h-12 w-full md:w-auto px-8 rounded-lg bg-accent hover:bg-[#F25F00] text-ink font-semibold text-base">Show jobs</button>
    </div>
  </form>
</header>
