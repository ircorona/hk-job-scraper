---
// Ink footer with the builder credit (same pattern as the Mexico dashboard).
const LI = 'https://www.linkedin.com/in/irmin-corona/';
const link = 'p-2 text-[#C9C3BA] hover:text-paper transition-colors';
---

<footer class="bg-ink text-paper mt-16">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="font-serif text-2xl leading-tight">Built by <a href={LI} target="_blank" rel="noopener noreferrer" class="underline decoration-[#57534E] underline-offset-4 hover:decoration-accent hover:text-[#FFB27A] transition-colors">Irmin Corona</a>, data analyst.</p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#C9C3BA]">Seven years in analytics at Microsoft and Stellantis. TTPS visa holder, moving to Hong Kong. Python pipeline, Astro front end, refreshed daily on GitHub Actions. Also: <a href="https://climbthesearches.com/jobs/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 text-paper hover:text-[#FFB27A] transition-colors">the Mexico job market</a>.</p>
        <p class="mt-1 text-sm text-[#A8A29E]">Sources: JobsDB, LinkedIn, Indeed, Lever and Greenhouse. &copy; {new Date().getFullYear()} ClimbTheSearches.</p>
      </div>
      <div class="flex items-center gap-2 -ml-2 md:ml-0">
        <a href={LI} target="_blank" rel="noopener noreferrer" class={link} aria-label="Irmin Corona on LinkedIn">
          <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://github.com/ircorona/hk-job-scraper" target="_blank" rel="noopener noreferrer" class={link} aria-label="Source code on GitHub">
          <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://climbthesearches.com/" class={link} aria-label="ClimbTheSearches home">
          <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
