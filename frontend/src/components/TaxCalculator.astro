---
// HK salaries tax + MPF calculator, 2025/26 IRD rates.
// Sources: gov.hk/en/residents/taxes, mpfa.org.hk
// MPF 5% capped at HK$1,500/mo, progressive bands, standard rate (15% / 16% above HK$5M), pay the lower.
---

<section class="bg-well border border-rule rounded-[10px] p-5 md:p-8 mb-10 md:mb-12" aria-labelledby="taxTitle">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
    <div class="md:col-span-5">
      <p class="text-sm font-medium text-ink-2">Salaries tax calculator</p>
      <h3 id="taxTitle" class="mt-1 font-serif text-2xl md:text-[1.75rem] leading-tight text-ink">What do you keep after tax and MPF?</h3>
      <label for="taxGross" class="block mt-5 text-sm font-medium text-ink-2 mb-1.5">Monthly gross salary (HKD)</label>
      <div class="relative">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-3 text-base" aria-hidden="true">HK$</span>
        <input id="taxGross" type="number" inputmode="numeric" min="0" step="1000" placeholder="35,000" autocomplete="off"
          class="w-full h-14 border border-rule-strong rounded-lg pl-14 pr-4 text-xl font-semibold num hover:border-ink-3 focus:border-ink focus:outline-none transition-colors" />
      </div>
      <p id="taxHint" class="text-sm text-ink-3 mt-2">Before tax. Filled with the median posted salary for this category when there is one.</p>
    </div>

    <div class="md:col-span-7 md:pt-1">
      <div id="taxResult" class="hidden" aria-live="polite">
        <dl class="grid grid-cols-3 gap-x-4 md:gap-x-6 gap-y-5 pb-5 border-b border-rule-strong">
          <div class="col-span-3 pb-1">
            <dt class="text-sm font-medium text-ink">Monthly take-home</dt>
            <dd id="taxMonthlyNet" class="mt-1 font-serif text-[2.75rem] md:text-[3.25rem] leading-none text-ink num">HK$0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-2">Tax per month</dt>
            <dd id="taxMonthlyTax" class="mt-1 text-lg md:text-xl font-semibold text-ink num">HK$0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-2">MPF (5%)</dt>
            <dd id="taxMonthlyMPF" class="mt-1 text-lg md:text-xl font-semibold text-ink num">HK$0</dd>
          </div>
          <div>
            <dt class="text-sm text-ink-2">Effective tax rate</dt>
            <dd id="taxEffRate" class="mt-1 text-lg md:text-xl font-semibold text-ink num">0%</dd>
          </div>
        </dl>
        <div class="pt-4">
          <div class="flex justify-between text-sm mb-2">
            <span class="text-ink-2">Tax and MPF, share of gross</span>
            <span id="taxDeductPct" class="font-semibold text-ink num">0%</span>
          </div>
          <div class="w-full bg-surface border border-rule rounded-sm h-2.5 overflow-hidden" aria-hidden="true">
            <div id="taxBar" class="h-full bg-accent transition-[width] duration-300 ease-out" style="width:0%"></div>
          </div>
          <p id="taxNoteText" class="text-sm text-ink-2 mt-3 num"></p>
        </div>
      </div>
      <p class="text-xs text-ink-3 mt-3 leading-relaxed">2025/26 IRD rates. Basic allowance HK$132,000. MPF 5%, capped at HK$1,500 a month, none below HK$7,100. You pay the lower of the progressive bands and the standard rate. Single person, no other deductions. Source: <a href="https://www.gov.hk/en/residents/taxes/taxfiling/taxrates/salariesrates.htm" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-accent-ink transition-colors">GovHK</a>.</p>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  function fmt(n) { return 'HK$' + Math.round(n).toLocaleString('en-US'); }

  function calcTax() {
    var monthly = parseFloat(document.getElementById('taxGross').value);
    var result = document.getElementById('taxResult');
    if (!monthly || monthly <= 0) { result.classList.add('hidden'); return; }

    // --- MPF (Mandatory Provident Fund) ---
    // Employee: 5% of income, capped at HK$1,500/month ($30,000 cap x 5%)
    // Below HK$7,100/month: no employee contribution
    var mpfMonthly = 0;
    if (monthly >= 7100) {
      mpfMonthly = Math.min(monthly * 0.05, 1500);
    }
    var mpfAnnual = mpfMonthly * 12;

    // --- Salaries Tax (2025/26) ---
    var annualGross = monthly * 12;

    // Assessable income after MPF deduction (MPF is tax-deductible up to $18,000/yr)
    var mpfDeductible = Math.min(mpfAnnual, 18000);
    var assessable = annualGross - mpfDeductible;

    // Net chargeable income = assessable - basic allowance ($132,000)
    var allowance = 132000;
    var chargeable = Math.max(0, assessable - allowance);

    // Progressive rates
    var bands = [[50000, 0.02], [50000, 0.06], [50000, 0.10], [50000, 0.14], [Infinity, 0.17]];
    var progressiveTax = 0;
    var rem = chargeable;
    for (var i = 0; i < bands.length; i++) {
      var taxable = Math.min(rem, bands[i][0]);
      progressiveTax += taxable * bands[i][1];
      rem -= taxable;
      if (rem <= 0) break;
    }

    // Standard rate: 15% of net income (assessable - deductions, before allowance)
    // Two-tiered since 2024/25: 15% on first $5M, 16% on remainder
    var standardBase = assessable;
    var standardTax;
    if (standardBase <= 5000000) {
      standardTax = standardBase * 0.15;
    } else {
      standardTax = 5000000 * 0.15 + (standardBase - 5000000) * 0.16;
    }

    // Pay whichever is lower
    var annualTax = Math.max(0, Math.min(progressiveTax, standardTax));
    var method = annualTax === progressiveTax ? 'progressive bands' : 'standard rate';

    var monthlyTax = annualTax / 12;
    var monthlyNet = monthly - mpfMonthly - monthlyTax;
    var effRate = annualGross > 0 ? ((annualTax / annualGross) * 100).toFixed(1) : '0.0';
    var deductPct = monthly > 0 ? Math.min(100, ((mpfMonthly + monthlyTax) / monthly) * 100) : 0;

    document.getElementById('taxMonthlyNet').textContent = fmt(monthlyNet);
    document.getElementById('taxMonthlyTax').textContent = fmt(monthlyTax);
    document.getElementById('taxMonthlyMPF').textContent = fmt(mpfMonthly);
    document.getElementById('taxEffRate').textContent = effRate + '%';
    document.getElementById('taxDeductPct').textContent = deductPct.toFixed(1) + '%';
    document.getElementById('taxBar').style.width = deductPct.toFixed(1) + '%';
    document.getElementById('taxNoteText').textContent = 'Tax ' + fmt(annualTax) + ' a year (' + method
      + '), MPF ' + fmt(mpfAnnual) + ' a year.';
    result.classList.remove('hidden');
  }

  // Called by index.astro after a category loads: fills the median only if the field is still untouched.
  window.hkTaxPrefill = function (median) {
    var el = document.getElementById('taxGross');
    if (!el || el.dataset.touched) return;
    el.value = median > 0 ? String(Math.round(median)) : '';
    calcTax();
  };

  document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('taxGross');
    if (!el) return;
    el.addEventListener('input', function () { el.dataset.touched = '1'; calcTax(); });
  });
})();
</script>
