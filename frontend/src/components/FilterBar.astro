---
// Job list filters. Defaults: posted in the last 7 days, Chinese not required, applied jobs hidden.
const sel = 'field w-full md:w-auto';
---

<div id="jobs" class="mb-3" style="scroll-margin-top: 1rem;">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 mb-4">
    <h2 class="font-serif text-2xl md:text-[1.75rem] leading-tight text-ink">Jobs</h2>
    <p id="filterSummary" class="text-sm text-ink-3 num" aria-live="polite"></p>
  </div>
  <div class="flex flex-col gap-2 md:gap-3">
    <div class="flex flex-col md:flex-row gap-2 md:gap-3">
      <input id="searchInput" type="search" autocomplete="off" aria-label="Search by job title or company" placeholder="Search title or company"
        class="field w-full md:flex-1 min-w-0 text-base" />
      <div class="grid grid-cols-2 md:flex gap-2 md:gap-3">
        <select id="postedFilter" aria-label="Posted within (Hong Kong date)" class={sel}>
          <option value="1">Posted today</option>
          <option value="3">Last 3 days</option>
          <option value="7" selected>Last 7 days</option>
          <option value="14">Last 14 days</option>
          <option value="">Any date</option>
        </select>
        <select id="langFilter" aria-label="Chinese-language requirement" class={sel}>
          <option value="no-req" selected>Chinese not required</option>
          <option value="none">No Chinese mentioned</option>
          <option value="">Any language</option>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 md:flex md:flex-wrap gap-2 md:gap-3 items-center">
      <select id="seniorityFilter" aria-label="Level" class={sel}>
        <option value="">All levels</option>
        <option value="Junior">Junior</option>
        <option value="Mid">Mid</option>
        <option value="Senior">Senior</option>
        <option value="Manager">Manager</option>
        <option value="Director+">Director+</option>
      </select>
      <select id="workModeFilter" aria-label="Work mode" class={sel}>
        <option value="">All work modes</option>
        <option value="Remote">Remote</option>
        <option value="Hybrid">Hybrid</option>
        <option value="On-site">On-site</option>
      </select>
      <select id="sourceFilter" aria-label="Source" class={sel}>
        <option value="">All sources</option>
        <option value="jobsdb">JobsDB</option>
        <option value="linkedin">LinkedIn</option>
        <option value="indeed">Indeed</option>
        <option value="lever">Lever</option>
        <option value="greenhouse">Greenhouse</option>
        <option value="google">Google Jobs</option>
      </select>
      <label class="chip" title="Only jobs that appeared in the latest daily run">
        <input type="checkbox" id="newFilter" class="w-4 h-4" />
        <span>New today</span>
      </label>
      <label class="chip" title="Employers known to hire internationally, or ads that mention visa support">
        <input type="checkbox" id="ttpsFilter" class="w-4 h-4" />
        <span>TTPS-friendly only</span>
      </label>
      <button type="button" id="showAppliedBtn" class="chip" aria-pressed="false">Show applied (<span id="appliedCount" class="num">0</span>)</button>
    </div>
  </div>
</div>
